{
  "name": "ember-wildfire-evacuation",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Research-based wildfire spread simulation and fire-aware evacuation navigation over Google photorealistic 3D maps (Kenneth Fire scenario).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/smoke.test.ts",
    "fetch-data": "node scripts/fetch-dem.mjs && node scripts/fetch-streets.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
